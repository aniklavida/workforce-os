# ─────────────────────────────────────────────
# Secrets — never commit these
# This project handles Notion API tokens and bot
# tokens. A leaked token in a public repo is live
# until it is revoked, so keep this list strict.
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.env
secrets.json
credentials.json
config.local.*
*.pem
*.key
*.p12
*.pfx
.netrc
.npmrc
.pypirc
token.txt
*token*.json
service-account*.json

# ─────────────────────────────────────────────
# Local agent / editor config
# ─────────────────────────────────────────────
.claude/settings.local.json
.claude/local/
.mcp.local.json
.cursor/
.aider*
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.history/

# ─────────────────────────────────────────────
# macOS
# ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?

# Windows / Linux
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory
.fuse_hidden*
.nfs*

# ─────────────────────────────────────────────
# Node
# ─────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/cache
.yarn/install-state.gz
dist/
build/
.next/
.nuxt/
.turbo/
.cache/
*.tsbuildinfo

# ─────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ─────────────────────────────────────────────
# Logs, temp, local scratch
# ─────────────────────────────────────────────
*.log
logs/
tmp/
temp/
.scratch/
scratch/
*.bak
*.orig
*.rej

# ─────────────────────────────────────────────
# Exported Notion data — may contain personal
# information. Keep exports out of the repo.
# ─────────────────────────────────────────────
notion-export/
*.notion
export/
*-backup/
