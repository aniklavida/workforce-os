# Copy to .env and fill in. Never commit .env.

# THE DEFAULT CONNECTION NEEDS NOTHING HERE.
# The recommended Notion path is the remote Notion MCP server with OAuth.
# You authorize it in your agent; there is no token to paste and no local
# server JSON to edit. The token block below is only for the optional direct
# REST API route and the proof script in scripts/. Leave it blank otherwise.

# Notion REST API token (fallback path only) — https://www.notion.so/my-integrations
NOTION_TOKEN=

# The task data source the API addresses. The 2025-09-03 Notion API makes the
# data source primary: reads and writes take a data_source_id, not database_id.
NOTION_DATA_SOURCE_ID=

# The page Workforce OS is built under.
# Take it from the page URL: notion.so/Title-<this-part>
NOTION_PARENT_PAGE_ID=

# IANA timezone, e.g. Asia/Dhaka, Europe/London, America/New_York.
# Set it once here. Agents must never hardcode a timezone anywhere else.
TIMEZONE=

# Workforce OS has no bot gateway or chat-channel adapter of its own, and no
# separate heartbeat or runtime consumer. The daily review message goes through
# whatever chat surface your connecting agent (Claude Code, Codex, etc.)
# already delivers through — there is nothing to configure here for that.
