# Copy to .env and fill in. Never commit .env.

# Notion integration token — https://www.notion.so/my-integrations
NOTION_TOKEN=

# The page Workforce OS is built under.
# Take it from the page URL: notion.so/Title-<this-part>
NOTION_PARENT_PAGE_ID=

# Where the daily message goes. Leave blank to skip.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# IANA timezone, e.g. Asia/Dhaka, Europe/London, America/New_York.
# Set it once here. Agents must never hardcode a timezone anywhere else.
TIMEZONE=
