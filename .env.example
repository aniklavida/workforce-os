# Copy to .env and fill in. Never commit .env.

# Notion integration token — https://www.notion.so/my-integrations
NOTION_TOKEN=

# The page Workforce OS is built under.
# Take it from the page URL: notion.so/Title-<this-part>
NOTION_PARENT_PAGE_ID=

# IANA timezone, e.g. Asia/Dhaka, Europe/London, America/New_York.
# Set it once here. Agents must never hardcode a timezone anywhere else.
TIMEZONE=

# Workforce OS has no bot gateway or chat-channel adapter of its own.
# The daily review message goes through whatever chat surface your
# connecting agent (Claude Code, Codex, etc.) already delivers through —
# there is nothing to configure here for that.
